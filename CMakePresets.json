{
    "version": 3,
    "configurePresets": [
        {
            "name": "gcc-base",
            "generator": "Unix Makefiles",
            "toolchainFile": "cmake/toolchain/gcc.cmake"
        },
        {
            "name": "clang-base",
            "generator": "Unix Makefiles",
            "toolchainFile": "cmake/toolchain/clang.cmake"
        },
        {
            "name": "gcc-debug",
            "inherits": "gcc-base",
            "binaryDir": "build/gcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gcc-relwdebinfo",
            "inherits": "gcc-base",
            "binaryDir": "build/gcc-relwdebinfo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "gcc-release",
            "inherits": "gcc-base",
            "binaryDir": "build/gcc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
                {
            "name": "clang-debug",
            "inherits": "clang-base",
            "binaryDir": "build/clang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-relwdebinfo",
            "inherits": "clang-base",
            "binaryDir": "build/clang-relwdebinfo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "clang-release",
            "inherits": "clang-base",
            "binaryDir": "build/clang-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "build-base",
            "hidden": true,
            "jobs": 16,
            "verbose": false
        },
        {
            "name": "gcc-debug",
            "inherits": "build-base",
            "configurePreset": "gcc-debug"
        },
        {
            "name": "gcc-relwdebinfo",
            "inherits": "build-base",
            "configurePreset": "gcc-relwdebinfo"
        },
        {
            "name": "gcc-release",
            "inherits": "build-base",
            "configurePreset": "gcc-release"
        },
        {
            "name": "clang-debug",
            "inherits": "build-base",
            "configurePreset": "clang-debug"
        },
        {
            "name": "clang-relwdebinfo",
            "inherits": "build-base",
            "configurePreset": "clang-relwdebinfo"
        },
        {
            "name": "clang-release",
            "inherits": "build-base",
            "configurePreset": "clang-release"
        }
    ]
}
