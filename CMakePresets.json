{
    "version": 12,
    "configurePresets": [
        {
            "name": "gcc-base",
            "generator": "Ninja",
            "toolchainFile": "cmake/toolchain/gcc.cmake",
            "binaryDir": "../build-${presetName}"
        },
        {
            "name": "clang-base",
            "generator": "Ninja",
            "toolchainFile": "cmake/toolchain/clang.cmake",
            "binaryDir": "../build-${presetName}",
            "cacheVariables": {
                "CMAKE_LINKER_TYPE": "LLD"
            }
        },
        {
            "name": "gcc-debug",
            "inherits": "gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gcc-relwithdebinfo",
            "inherits": "gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "gcc-release",
            "inherits": "gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "clang-debug",
            "inherits": "clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-relwithdebinfo",
            "inherits": "clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "clang-release",
            "inherits": "clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "build-base",
            "hidden": true,
            "verbose": false
        },
        {
            "name": "gcc-debug",
            "inherits": "build-base",
            "configurePreset": "gcc-debug"
        },
        {
            "name": "gcc-relwithdebinfo",
            "inherits": "build-base",
            "configurePreset": "gcc-relwithdebinfo"
        },
        {
            "name": "gcc-release",
            "inherits": "build-base",
            "configurePreset": "gcc-release"
        },
        {
            "name": "clang-debug",
            "inherits": "build-base",
            "configurePreset": "clang-debug"
        },
        {
            "name": "clang-relwithdebinfo",
            "inherits": "build-base",
            "configurePreset": "clang-relwithdebinfo"
        },
        {
            "name": "clang-release",
            "inherits": "build-base",
            "configurePreset": "clang-release"
        }
    ],

    "testPresets": [
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "gcc-release",
            "configurePreset": "gcc-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
