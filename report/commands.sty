% Tikz
\newcommand{\drawci}[3]{%
  \begin{tikzpicture}[baseline=-0.5ex, scale=0.8]
    \pgfmathsetmacro{\minval}{#1/100}
    \pgfmathsetmacro{\meanval}{#2/100}
    \pgfmathsetmacro{\maxval}{#3/100}
    \draw[thick] (\minval,0) -- (\maxval,0);
    \draw (\minval,-0.1) -- (\minval,0.1);
    \draw (\maxval,-0.1) -- (\maxval,0.1);
    \fill (\meanval,0) circle (0.05);
  \end{tikzpicture}%
}

